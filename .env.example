# Groq (not xAI Grok): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Conservative starting budgets for Groq's free tier; check your account limits.
GROQ_RPM=25
GROQ_TPM=8000
GROQ_MAX_COMPLETION_TOKENS=1000
# Role-specific cloud routing. Unconfigured primaries use available cloud fallbacks.
MORGAN_PROVIDER=groq
AVERY_PROVIDER=cerebras
JORDAN_PROVIDER=cloudflare
CAMERON_PROVIDER=gemini
CEREBRAS_ENABLED=true
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_RPM=5
CEREBRAS_TPM=30000
CEREBRAS_TPD=900000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
# Pro has no free API tier. Use a verified free model before confirming free access.
GEMINI_FREE_TIER_CONFIRMED=false
MISTRAL_API_KEY=
MISTRAL_MODEL=codestral-latest
MISTRAL_FREE_TIER_CONFIRMED=false
AI_PAID_USAGE_ALLOWED=false
CLOUDFLARE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# Cloud-only final fallback; never routes to a paid OpenRouter model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional live web research: https://tavily.com (1,000 free monthly credits).
TAVILY_API_KEY=

# Staff mail: off until addresses/provider are configured; draft makes local .eml files.
STAFF_EMAIL_MODE=off
# Internal named staff/CEO mail can send automatically while outside mail stays in approval mode.
STAFF_INTERNAL_EMAIL_MODE=send
STAFF_EMAIL_TEAM_UPDATES=true
OWNER_EMAIL=ceo@onyxandink.org
# Jaunee, Vice President. This address is internal and receives important CEO-message copies.
IMPORTANT_CC_EMAIL=
MORGAN_EMAIL=coo@onyxandink.org
AVERY_EMAIL=marketing@onyxandink.org
JORDAN_EMAIL=it@onyxandink.org
CAMERON_EMAIL=hr@onyxandink.org
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
# One authorized alias account OR per-agent accounts. Keep passwords local.
SMTP_USER=
SMTP_PASSWORD=
MORGAN_SMTP_USER=
MORGAN_SMTP_PASSWORD=
AVERY_SMTP_USER=
AVERY_SMTP_PASSWORD=
JORDAN_SMTP_USER=
JORDAN_SMTP_PASSWORD=
CAMERON_SMTP_USER=
CAMERON_SMTP_PASSWORD=
OWNER_BCC_EMAIL=owner-copy@example.com
BUSINESS_WEBSITE=https://onyxandink.org

# Shared Gmail inbox; blank user/password fall back to SMTP_USER/SMTP_PASSWORD.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
INBOX_POLL_SECONDS=60
INBOX_BATCH_LIMIT=5

GOOGLE_MAIL_AUTH=oauth
GOOGLE_MAIL_USER=inbox@onyxandink.org
CREWAI_TELEMETRY_DISABLED=true
CREWAI_TRACING_ENABLED=false

# Cloud deployment only. Keep DASHBOARD_PASSWORD private and remove it after
# the first successful start; its salted verifier is persisted under work/.
ONYX_CLOUD_MODE=false
ONYX_PUBLIC_ORIGIN=
# Set these for a Windows/Docker installation reachable from your home network.
ONYX_REQUIRE_LOGIN=false
ONYX_ALLOWED_HOSTS=
DASHBOARD_PASSWORD=

# Optional Telegram bot token; enter through dashboard Settings.
TELEGRAM_BOT_TOKEN=
# Optional dedicated Telegram bots — one bot per staff role
TELEGRAM_MORGAN_BOT_TOKEN=
TELEGRAM_AVERY_BOT_TOKEN=
TELEGRAM_JORDAN_BOT_TOKEN=
TELEGRAM_CAMERON_BOT_TOKEN=
# Optional Morgan daily project brief channel (-100… ID or public @channelusername).
TELEGRAM_DAILY_BRIEF_CHAT=
TELEGRAM_DAILY_BRIEF_TIME=09:00

# Staff chat actions; internal named recipients send automatically, outside addresses require approval.
AGENT_TOOLS_ENABLED=true
# Sign in separately with workspace_tools.py --authorize (drive.file / owned calendar).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FREE_PLAN_CONFIRMED=false

# Private staff group for autonomous bot-to-bot handoffs and generated files.
TELEGRAM_AGENT_GROUP_CHAT=
# Comma-separated external email addresses that agents may contact and attach files to without an Outbox review.
AUTONOMOUS_EXTERNAL_EMAILS=

# Square Catalog API is free to use; transaction fees apply only when a sale completes.
# Begin with sandbox. Switch to production only after end-to-end testing.
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
# Optional website rollout metadata for Cloudflare Pages.
CLOUDFLARE_PAGES_PROJECT=
CLOUDFLARE_PAGES_BRANCH=main
# Optional Discord staff workspace. Save credentials through Dashboard Settings.
# Use one shared bot first; optional role bot tokens make each staff member appear
# as a distinct Discord bot. Enable Message Content Intent in Developer Portal.
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_STAFF_CHANNEL_ID=
DISCORD_AGENT_REQUESTS_CHANNEL_ID=
DISCORD_DAILY_BRIEF_CHANNEL_ID=
DISCORD_MORGAN_CHANNEL_ID=
DISCORD_AVERY_CHANNEL_ID=
DISCORD_JORDAN_CHANNEL_ID=
DISCORD_CAMERON_CHANNEL_ID=
DISCORD_MORGAN_BOT_TOKEN=
DISCORD_AVERY_BOT_TOKEN=
DISCORD_JORDAN_BOT_TOKEN=
DISCORD_CAMERON_BOT_TOKEN=
